# Copy to .env (git-ignored). Real environment variables override these.

# StepFun — orchestration (triage + synthesis). Global endpoint; without it the
# deterministic dispatch/ranking is used and specialist results still show.
STEP_API_KEY=
# INTEGREAT_STEPFUN_MODEL=step-5-preview
# INTEGREAT_STEPFUN_BASE_URL=https://api.stepfun.ai/v1

# Gemini — specialist agents (Code / Hardware / Runtime-Vision). Without it,
# StepFun still synthesizes deterministic evidence; specialists show as unavailable.
GEMINI_API_KEY=
# Set explicitly; check the current model list in Google AI Studio. Example: gemini-2.5-flash
INTEGREAT_GEMINI_MODEL=
INTEGREAT_AGENT_TIMEOUT_S=30
INTEGREAT_MAX_CONTEXT_TOKENS=6000

# Devin Cloud — remote, reviewable software-fix proposals (never applied locally).
# Service-user key (cog_...) + org id from Settings → Devin API.
DEVIN_API_KEY=
INTEGREAT_DEVIN_ORG_ID=
# Optional repo override when the git remote can't be normalized to owner/name:
# INTEGREAT_DEVIN_REPO=owner/name
# Per-session resource cap sent as max_acu_limit:
# INTEGREAT_DEVIN_MAX_ACU=10

# Storage / fixtures
# INTEGREAT_DB_PATH=apps/api/.data/integreat.db
# INTEGREAT_FIXTURES_DIR=fixtures
# 1.0 = replays play in real time; 0 = instant
INTEGREAT_REPLAY_SPEED=1.0
